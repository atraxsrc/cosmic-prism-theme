# Prism for Ghostty, part of cosmic-prism-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = Prism
# or, with the Prism Day half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Prism,light:PrismDay

background = #060D1F
foreground = #E0F7FA

cursor-color = #F7C3C6
cursor-text = #060D1F

selection-background = #262E40
selection-foreground = #E0F7FA

split-divider-color = #5A6B8C
unfocused-split-fill = #060D1F

# black
palette = 0=#030710
