# Prism for delta (the git diff pager), part of cosmic-prism-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Prism theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/prism.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = prism

[delta "prism"]
    dark = true
    syntax-theme = Prism
    navigate = true
    line-numbers = true

    file-style = bold "#F7C3C6"
    file-decoration-style = "#5A6B8C" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#5A6B8C" box
    hunk-header-file-style = "#85CEC4"
    hunk-header-line-number-style = "#D5EDEB"

    minus-style = "#E95C4B" "#0E1628"
    minus-emph-style = bold "#060D1F" "#E95C4B"
    minus-non-emph-style = "#E95C4B" "#0E1628"
    plus-style = "#6488EA" "#0E1628"
    plus-emph-style = bold "#060D1F" "#6488EA"
    plus-non-emph-style = "#6488EA" "#0E1628"
    zero-style = syntax
    whitespace-error-style = "#060D1F" "#FFA69E"

    line-numbers-left-style = "#5A6B8C"
    line-numbers-right-style = "#5A6B8C"
    line-numbers-minus-style = "#E95C4B"
    line-numbers-plus-style = "#6488EA"
    line-numbers-zero-style = "#5A6B8C"

    commit-style = bold "#D5EDEB"
    commit-decoration-style = "#5A6B8C" box
    blame-palette = "#060D1F #0E1628 #161F33"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#6488EA"
    merge-conflict-theirs-diff-header-style = bold "#FFA69E"
